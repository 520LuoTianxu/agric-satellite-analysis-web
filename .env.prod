# 正式站点公开配置，由 npm run build:prod 显式加载。
# 地图 Key 为浏览器端调用标识，沿用农业管理端；禁止在此保存服务端密钥。
API_ENV=production
NEXT_PUBLIC_BASE_PATH=/agric-satellite-analysis-web
NEXT_PUBLIC_API_URL=/satellite-api
# 静态站点由浏览器直连正式网关，地址在构建时写入前端资源。
NEXT_PUBLIC_DIRECT_API_PROXY=true
NEXT_PUBLIC_JOINT_VENTURE_PROXY=https://joint-venture.cdfinance.com.cn
NEXT_PUBLIC_SATELLITE_API_PROXY=https://joint-venture.cdfinance.com.cn
NEXT_PUBLIC_SITE_URL=https://joint-venture.cdfinance.com.cn/agric-satellite-analysis-web
NEXT_PUBLIC_PROTOMAPS_URL=
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# 本地 next dev 使用非公开同名变量进行同源代理；正式构建保持同一正式 API 环境。
JOINT_VENTURE_PROXY=https://joint-venture.cdfinance.com.cn
SATELLITE_API_PROXY=https://joint-venture.cdfinance.com.cn
