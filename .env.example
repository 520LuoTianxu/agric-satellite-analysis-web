# Public API URL used by browser-side requests.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# Optional reverse-proxy path prefix; leave empty when deploying at the domain root.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PROTOMAPS_URL=
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# Server-side NextAuth settings.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ENABLE_DEMO_LOGIN=false
OPENFARM_JWT_SECRET=change-me-to-a-random-64-char-string
INTERNAL_API_URL=http://localhost:8000
DATABASE_URL=postgresql://openfarm:openfarm_dev@localhost:5432/openfarm
