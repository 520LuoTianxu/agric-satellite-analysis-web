# Public API gateway used by browser-side requests.
# Set NEXT_PUBLIC_DIRECT_API_PROXY=true for a static deployment without a
# reverse proxy. The browser then calls the two public gateway origins below.
# Local next dev keeps this false and rewrites /satellite-api to
# SATELLITE_API_PROXY/satellite-api (test gateway → FastAPI /v1).
NEXT_PUBLIC_API_URL=/satellite-api
NEXT_PUBLIC_DIRECT_API_PROXY=false
NEXT_PUBLIC_JOINT_VENTURE_PROXY=https://joint-venture.cdfinance.com.cn
NEXT_PUBLIC_SATELLITE_API_PROXY=https://joint-venture-test.cdfinance.com.cn
# Optional reverse-proxy path prefix; leave empty when deploying at the domain root.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_PROTOMAPS_URL=
# 默认底图直接使用高德卫星瓦片，无需额外配置地图 Key。
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com
# Include the deployment path in this URL when the site is mounted below a prefix.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# 本地 next dev 的非公开代理目标；测试静态构建请使用上面的 NEXT_PUBLIC_* 公开地址。
JOINT_VENTURE_PROXY=https://joint-venture.cdfinance.com.cn
SATELLITE_API_PROXY=https://joint-venture-test.cdfinance.com.cn

# Server-side NextAuth settings.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ENABLE_DEMO_LOGIN=false
OPENFARM_JWT_SECRET=change-me-to-a-random-64-char-string
DATABASE_URL=postgresql://openfarm:openfarm_dev@localhost:5432/openfarm
