# 测试站点公开配置，由 npm run build:test 显式加载。
# 地图 Key 为浏览器端调用标识，沿用农业管理端；禁止在此保存服务端密钥。
NEXT_PUBLIC_BASE_PATH=/agric-satellite-analysis-web
NEXT_PUBLIC_API_URL=/satellite-api
# 所有前端 API 在静态站点中都由浏览器直连测试网关。
NEXT_PUBLIC_DIRECT_API_PROXY=true
NEXT_PUBLIC_JOINT_VENTURE_PROXY=https://joint-venture-test.cdfinance.com.cn
NEXT_PUBLIC_SATELLITE_API_PROXY=https://joint-venture-test.cdfinance.com.cn
NEXT_PUBLIC_SITE_URL=https://joint-venture-test.cdfinance.com.cn/agric-satellite-analysis-web
NEXT_PUBLIC_PROTOMAPS_URL=
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
# 本地 next dev 使用非公开同名变量进行同源代理；静态构建使用公开配置直连测试网关。
JOINT_VENTURE_PROXY=https://joint-venture-test.cdfinance.com.cn
SATELLITE_API_PROXY=https://joint-venture-test.cdfinance.com.cn
