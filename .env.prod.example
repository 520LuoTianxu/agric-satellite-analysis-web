# 生产静态站点公开配置；请复制为 .env.prod 后按实际域名修改。
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_URL=/satellite-api
NEXT_PUBLIC_DIRECT_API_PROXY=false
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example.com
NEXT_PUBLIC_PROTOMAPS_URL=
NEXT_PUBLIC_OSS_URL=https://agric-dev.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_GLOSSARY_ASSET_BASE=
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# 仅当 NEXT_PUBLIC_DIRECT_API_PROXY=true 时需要填写。
NEXT_PUBLIC_JOINT_VENTURE_PROXY=https://your-business-api.example.com
NEXT_PUBLIC_SATELLITE_API_PROXY=https://your-satellite-api.example.com
